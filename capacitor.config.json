{
  "appId": "com.hendist.hokicards",
  "appName": "Hoki Cards",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "screenOrientation": "sensorLandscape"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#050e05"
    },
    "NavigationBar": {
      "backgroundColor": "#050e05"
    }
  }
}
