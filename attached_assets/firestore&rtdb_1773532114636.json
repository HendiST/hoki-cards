rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()      { return request.auth != null; }
    function isOwner(uid)  { return isAuth() && request.auth.uid == uid; }
    function isAdmin()     { return isAuth() && request.auth.uid == "nl8JN4JnzSVqtdGGFvhNWW44FuH2"; }
    function notBanned()   { return !("banned" in resource.data) || resource.data.banned == false; }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) && notBanned()) || isAdmin();
      allow delete: if isAdmin();

      match /friends/{friendUid} {
        allow read:   if isOwner(uid);
        allow create: if isAuth()
          && request.resource.data.uid    == friendUid
          && request.resource.data.name   is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.addedAt is int;
        allow delete: if isOwner(uid) || isOwner(friendUid);
        allow update: if false;
      }

      match /friend_requests/{fromUid} {
        allow read:   if isOwner(uid) || (isAuth() && request.auth.uid == fromUid);
        allow create: if isAuth()
          && request.auth.uid    == fromUid
          && request.resource.data.uid  == fromUid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.ts   is int;
        allow delete: if isOwner(uid) || (isAuth() && request.auth.uid == fromUid);
        allow update: if false;
      }

      match /matches/{matchId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.result    is string
          && request.resource.data.opponents is string
          && request.resource.data.ts        is int;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Usernames ──────────────────────────────────────────────────────
    match /usernames/{username} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── Global Chat ────────────────────────────────────────────────────
    match /global_chat/{msgId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid      == request.auth.uid
        && request.resource.data.text     is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 80
        && request.resource.data.name     is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.ts       is int
        && request.resource.data.expireAt is timestamp
        && (!('replyTo' in request.resource.data)
            || (request.resource.data.replyTo.name is string
                && request.resource.data.replyTo.text is string
                && request.resource.data.replyTo.text.size() <= 40));
      allow update: if false;
      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    // ── Private Messages ───────────────────────────────────────────────
    match /pm/{convId} {
      function isParticipant() {
        return isAuth() && (
          convId.matches('^' + request.auth.uid + '_.*') ||
          convId.matches('.*_' + request.auth.uid + '$')
        );
      }
      match /messages/{msgId} {
        allow read:   if isParticipant();
        allow delete: if isParticipant();
        allow update: if false;
        allow create: if isParticipant()
          && request.resource.data.uid  == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.ts   is int
          && (!('replyTo' in request.resource.data)
              || (request.resource.data.replyTo.name is string
                  && request.resource.data.replyTo.text is string
                  && request.resource.data.replyTo.text.size() <= 80));
      }
    }

    // ── Leaderboard Global ─────────────────────────────────────────────
    match /leaderboard/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid)
        && request.resource.data.uid       == uid
        && request.resource.data.name      is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.stars     is int
        && request.resource.data.stars     >= 0
        && request.resource.data.updatedAt is int;
      allow update: if isOwner(uid)
        && request.resource.data.uid       == uid
        && request.resource.data.name      is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.stars     is int
        && request.resource.data.stars     >= 0
        && request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }

    // ── Leaderboard Mingguan ───────────────────────────────────────────
    match /leaderboard_weekly/{weekId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();

      match /entries/{uid} {
        allow read:   if isAuth();
        allow create: if isOwner(uid)
          && request.resource.data.uid       == uid
          && request.resource.data.name      is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.stars     is int
          && request.resource.data.stars     >= 0
          && request.resource.data.updatedAt is int;
        allow update: if isOwner(uid)
          && request.resource.data.uid       == uid
          && request.resource.data.name      is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.stars     is int
          && request.resource.data.stars     >= 0
          && request.resource.data.updatedAt is int;
        allow delete: if isAdmin();
      }
    }

    // ── Cheat Access (dikelola Owner via panel) ────────────────────────
    match /cheat_access/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Blokir semua akses lain ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "info": {
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "actions":   { ".write": "auth != null" },
        "state":     { ".write": "auth != null" },
        "hands": {
          "$uid": {
            ".read":  "auth != null && auth.uid === $uid",
            ".write": "auth != null"
          }
        },
        "errors": {
          "$uid": {
            ".read":  "auth != null && auth.uid === $uid",
            ".write": "auth != null"
          }
        },
        "presence": {
          "$uid": {
            ".read":  "auth != null",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            ".validate": "newData.hasChildren(['name','text','ts','uid']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 80 && newData.child('ts').isNumber() && newData.child('uid').isString() && newData.child('uid').val() === auth.uid"
          }
        },
        "reactions": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$reactionId": {
            ".validate": "newData.hasChildren(['emoji','uid','name','ts']) && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8 && newData.child('uid').isString() && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('ts').isNumber()"
          }
        }
      }
    },
"global_message": {
  ".read": "auth != null",
  ".write": "auth.uid === 'nl8JN4JnzSVqtdGGFvhNWW44FuH2'"
},
    "users": {
      "$uid": {
        "online": {
          ".read":     "auth != null",
          ".write":    "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        },
        "invites": {
          "$roomId": {
            ".read":  "auth != null && auth.uid === $uid",
            ".write": "auth != null",
            ".validate": "!newData.exists() || (newData.hasChildren(['rid','hostUid','hostName','numPlayers','ts']) && newData.child('rid').isString() && newData.child('rid').val().length <= 6 && newData.child('hostUid').isString() && newData.child('hostName').isString() && newData.child('hostName').val().length <= 20 && newData.child('numPlayers').isNumber() && newData.child('ts').isNumber())"
          }
        }
      }
    }
  }
}